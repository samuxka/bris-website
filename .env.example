# Public client variables (safe for browser, protected by Supabase RLS)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Server-only secrets (DO NOT prefix with VITE_)
# Generate ADMIN_PIN_HASH with:
# node -e "const c=require('crypto'),s=c.randomBytes(16).toString('hex');console.log(s+':'+c.scryptSync('YOUR_6_DIGIT_PIN',s,64).toString('hex'))"
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
ADMIN_PIN_HASH=salt_hex:scrypt_derived_key_hex
ADMIN_SESSION_SECRET=64_char_random_hex_secret
